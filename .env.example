# ==============================================================================
# MAILSHIELD CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env or set environment variables in your system.
# NEVER commit secrets, real API keys, or user credentials to version control!
# ==============================================================================

# Application Environment
MAILSHIELD_ENV=development
MAILSHIELD_LOG_LEVEL=INFO
MAILSHIELD_DATA_DIR=data

# Local SQLite Database
MAILSHIELD_DB_PATH=data/mailshield.db

# Google Gmail API Integration (Desktop OAuth2 PKCE)
# Register in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Desktop app)
MAILSHIELD_GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
MAILSHIELD_GMAIL_CLIENT_SECRET=your-google-client-secret
MAILSHIELD_GMAIL_REDIRECT_PORT=8888

# Microsoft Graph / Outlook Integration (Delegated Authentication)
# Register in Microsoft Entra admin center -> App registrations -> Supported account types -> Mobile and desktop applications
MAILSHIELD_OUTLOOK_CLIENT_ID=your-microsoft-entra-client-id
MAILSHIELD_OUTLOOK_TENANT_ID=common

# Optional Threat Intelligence API Keys (Requires explicit user consent in UI)
# Leave blank to use deterministic local offline intelligence fixtures
MAILSHIELD_VIRUSTOTAL_API_KEY=
MAILSHIELD_ABUSEIPDB_API_KEY=

# Monitoring Service Settings
MAILSHIELD_POLL_INTERVAL_SECONDS=60
MAILSHIELD_MAX_MESSAGES_PER_POLL=25
MAILSHIELD_AUTO_ANALYZE=true

